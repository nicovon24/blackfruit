# Copiar a .env.local para desarrollo. Neon CLI puede completar estas URLs al vincular una rama.
# Usar sslmode=verify-full en ambas URLs PostgreSQL para verificar el certificado TLS explícitamente.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Configurar un secreto diferente por entorno antes de habilitar el acceso.
BETTER_AUTH_SECRET=

# Producción: exactamente dos correos completos separados por coma. En desarrollo puede omitirse para QA.
ALLOWED_LOGIN_EMAILS=
