generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tablas generadas a partir de Better Auth 1.7.7 con el plugin admin.
// Cambios futuros en auth.ts requieren regenerar y revisar el diff antes de migrar.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  salesCreated  Sale[]       @relation("sale_creator")
  auditEvents   AuditEvent[]
  importBatches ImportBatch[]

  @@unique([email])
  @@map("user")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("customer")
}

model Product {
  id             String     @id @default(uuid())
  name           String
  variant        String?
  unitLabel      String?
  suggestedPrice Decimal?   @db.Decimal(14, 2)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  saleLines      SaleLine[]

  @@map("product")
}

model Sale {
  id         String     @id @default(uuid())
  occurredOn DateTime  @db.Date
  mode       String     @default("amount")
  status     String     @default("confirmed")
  currency   String     @default("ARS")
  total      Decimal    @db.Decimal(14, 2)
  channel    String?
  notes      String?
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById String
  createdBy  User       @relation("sale_creator", fields: [createdById], references: [id], onDelete: Restrict)
  requestKey String?    @unique
  version    Int        @default(1)
  voidedAt   DateTime?  @db.Timestamptz(3)
  deletedAt  DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)
  lines      SaleLine[]
  importRows ImportSourceRow[]

  @@index([occurredOn, status, deletedAt])
  @@index([customerId])
  @@map("sale")
}

model SaleLine {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  variant     String?
  unitLabel   String?
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  subtotal    Decimal  @db.Decimal(14, 2)
  position    Int

  @@unique([saleId, position])
  @@index([productId])
  @@map("sale_line")
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  entityType  String
  entityId    String
  action      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@map("audit_event")
}

model ImportBatch {
  id            String   @id @default(uuid())
  actorId       String
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fileName      String
  fileHash      String
  workbook      Json
  config        Json?
  previewHash   String?
  status        String   @default("draft")
  result        Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  confirmedAt   DateTime? @db.Timestamptz(3)
  rows          ImportSourceRow[]

  @@map("import_batch")
}

model ImportSourceRow {
  id            String @id @default(uuid())
  batchId       String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sheet         String
  rowNumber     Int
  kind          String
  rawName       String?
  raw           Json
  originKey     String? @unique
  rowHash       String
  saleId        String?
  sale          Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([batchId, sheet, rowNumber])
  @@index([saleId])
  @@map("import_source_row")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
