{
  "name": "blackfruit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:imports": "node --import tsx tests/imports.test.ts",
    "test:customer-import": "node --env-file=.env.local --import tsx tests/customer-import-integration.ts",
    "test:trash:integration": "node --env-file=.env.local --import tsx tests/trash-integration.ts",
    "test:trash:browser": "node --env-file=.env.local --import tsx tests/trash-browser.ts",
    "test:customer-edit:integration": "node --env-file=.env.local --import tsx tests/customer-edit-integration.ts",
    "test:kg-format": "node --import tsx tests/format-dashboard-kg.test.ts",
    "test:production-dashboard:browser": "node --env-file=.env.local --import tsx tests/production-dashboard-browser.ts",
    "test:ui-theme:browser": "node --env-file=.env.local --import tsx tests/ui-theme-browser.ts",
    "dev:cleanup-example": "node --env-file=.env.local --import tsx scripts/cleanup-production-example.ts",
    "dev:preview-sale-customers": "node --env-file=.env.local --import tsx scripts/preview-sales-customer-backfill.ts",
    "dev:backfill-sale-customers": "node --env-file=.env.local --import tsx scripts/backfill-sales-customers-dev.ts",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:deploy:production": "prisma migrate deploy --config prisma.production.config.ts",
    "auth:schema:check": "node --env-file=.env.local node_modules/auth/dist/index.mjs check schema --config ./src/lib/auth.ts",
    "auth:admin:create": "node --env-file=.env.local node_modules/auth/dist/index.mjs create-admin --config ./src/lib/auth.ts",
    "test:auth": "node --import tsx tests/auth-permissions.test.ts",
    "test:login-allowlist": "node --import tsx tests/login-allowlist.test.ts",
    "test:auth-hosts": "node --import tsx tests/auth-hosts.test.ts",
    "test:login-allowlist:integration": "node --env-file=.env.local --import tsx tests/login-allowlist-integration.ts",
    "test:sales": "node --import tsx tests/sales-domain.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx tests/auth-integration.ts",
    "test:browser": "node --env-file=.env.local --import tsx tests/browser-journey.ts"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.7",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-three/fiber": "^9.8.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "4.4.0",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "auth": "1.7.7",
    "dotenv": "18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "7.10.0",
    "shadcn": "4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  }
}
